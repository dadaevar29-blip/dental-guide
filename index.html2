<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Dental Guide 🦷</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #eef8ff, #ffffff);
      color: #17324d;
    }

    .app {
      max-width: 760px;
      margin: auto;
      padding: 25px 16px 45px;
    }

    .logo {
      text-align: center;
      font-size: 34px;
      font-weight: bold;
      margin-top: 10px;
    }

    .subtitle {
      text-align: center;
      color: #668096;
      margin: 8px 0 25px;
      font-size: 16px;
    }

    .tooth {
      width: 190px;
      height: 220px;
      margin: 20px auto;
      background: white;
      border-radius: 50% 50% 42% 42%;
      box-shadow: 0 15px 35px rgba(60,100,130,.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 85px;
    }

    .intro {
      background: white;
      border-radius: 22px;
      padding: 20px;
      margin-bottom: 20px;
      box-shadow: 0 10px 30px rgba(50,90,120,.10);
      line-height: 1.6;
    }

    .category {
      margin-top: 25px;
      margin-bottom: 10px;
      font-size: 20px;
      font-weight: bold;
    }

    .question {
      width: 100%;
      border: none;
      padding: 16px;
      margin-top: 9px;
      border-radius: 15px;
      background: white;
      color: #17324d;
      font-size: 15px;
      text-align: left;
      cursor: pointer;
      box-shadow: 0 5px 18px rgba(50,90,120,.08);
      transition: .2s;
    }

    .question:hover {
      transform: translateY(-2px);
      background: #eef7ff;
    }

    .answer-box {
      display: none;
      background: #eef7ff;
      border-radius: 20px;
      padding: 20px;
      margin-top: 15px;
      line-height: 1.65;
      box-shadow: 0 5px 20px rgba(50,90,120,.08);
    }

    .answer-title {
      font-weight: bold;
      font-size: 18px;
      margin-bottom: 10px;
    }

    .small {
      text-align: center;
      margin-top: 30px;
      color: #8aa0b0;
      font-size: 13px;
      line-height: 1.5;
    }

    .back {
      display: none;
      border: none;
      background: #17324d;
      color: white;
      padding: 12px 18px;
      border-radius: 12px;
      margin-bottom: 15px;
      cursor: pointer;
    }
  </style>
</head>

<body>

<div class="app">

  <div class="logo">
    🦷 Dental Guide
  </div>

  <div class="subtitle">
    Спроси у зуба — он объяснит
  </div>

  <div class="tooth">
    🦷
  </div>

  <div class="intro" id="intro">
    <b>Привет! Я твой Зубик 🦷</b>
    <br><br>
    Я помогу тебе разобраться в том, как устроены зубы,
    как правильно за ними ухаживать и почему профилактика
    так важна.
    <br><br>
    Выбери интересующий вопрос ниже — и я объясню всё простыми словами.
  </div>

  <button class="back" id="backButton" onclick="goBack()">
    ← Вернуться к вопросам
  </button>

  <div id="questions">

    <div class="category">🪥 Ежедневная гигиена</div>

    <button class="question" onclick="showAnswer('Как правильно чистить зубы?')">
      🪥 Как правильно чистить зубы?
    </button>

    <button class="question" onclick="showAnswer('Как долго нужно чистить зубы?')">
      ⏱️ Как долго нужно чистить зубы?
    </button>

    <button class="question" onclick="showAnswer('Сколько раз в день чистить зубы?')">
      🔄 Сколько раз в день нужно чистить зубы?
    </button>

    <button class="question" onclick="showAnswer('Как выбрать зубную щётку?')">
      🪥 Как выбрать зубную щётку?
    </button>

    <button class="question" onclick="showAnswer('Как выбрать зубную пасту?')">
      🧴 Как выбрать зубную пасту?
    </button>

    <button class="question" onclick="showAnswer('Нужно ли чистить язык?')">
      👅 Нужно ли чистить язык?
    </button>

    <button class="question" onclick="showAnswer('Зачем нужна зубная нить?')">
      🧵 Зачем нужна зубная нить?
    </button>


    <div class="category">🦠 Кариес и заболевания зубов</div>

    <button class="question" onclick="showAnswer('Что такое кариес?')">
      🦠 Что такое кариес?
    </button>

    <button class="question" onclick="showAnswer('Почему появляется кариес?')">
      ❓ Почему появляется кариес?
    </button>

    <button class="question" onclick="showAnswer('Можно ли остановить кариес?')">
      🛑 Можно ли остановить кариес?
    </button>

    <button class="question" onclick="showAnswer('Почему болит зуб?')">
      😣 Почему может болеть зуб?
    </button>

    <button class="question" onclick="showAnswer('Почему зуб реагирует на холодное?')">
      🧊 Почему зуб реагирует на холодное?
    </button>

    <button class="question" onclick="showAnswer('Что такое пульпа?')">
      🩸 Что такое пульпа?
    </button>

    <button class="question" onclick="showAnswer('Что такое зубная эмаль?')">
      🦷 Что такое эмаль?
    </button>

    <button class="question" onclick="showAnswer('Что такое дентин?')">
      🔬 Что такое дентин?
    </button>


    <div class="category">🦷 Строение зуба</div>

    <button class="question" onclick="showAnswer('Из чего состоит зуб?')">
      🔬 Из чего состоит зуб?
    </button>

    <button class="question" onclick="showAnswer('Зачем нужен корень зуба?')">
      🌱 Зачем зубу нужен корень?
    </button>

    <button class="question" onclick="showAnswer('Что находится внутри зуба?')">
      🔎 Что находится внутри зуба?
    </button>


    <div class="category">😁 Брекеты и ортодонтия</div>

    <button class="question" onclick="showAnswer('Зачем нужны брекеты?')">
      😁 Зачем нужны брекеты?
    </button>

    <button class="question" onclick="showAnswer('Как чистить зубы с брекетами?')">
      🪥 Как чистить зубы с брекетами?
    </button>

    <button class="question" onclick="showAnswer('Что нельзя есть с брекетами?')">
      🍎 Что нежелательно есть с брекетами?
    </button>

    <button class="question" onclick="showAnswer('Зачем нужен ретейнер?')">
      🦷 Зачем нужен ретейнер?
    </button>


    <div class="category">🍎 Питание и зубы</div>

    <button class="question" onclick="showAnswer('Какие продукты полезны для зубов?')">
      🍎 Какие продукты полезны для зубов?
    </button>

    <button class="question" onclick="showAnswer('Почему сладкое влияет на зубы?')">
      🍬 Почему сладкое влияет на зубы?
    </button>

    <button class="question" onclick="showAnswer('Вредны ли сладкие напитки?')">
      🥤 Вредны ли сладкие напитки для зубов?
    </button>

    <button class="question" onclick="showAnswer('Почему важно пить воду?')">
      💧 Почему вода важна для зубов?
    </button>


    <div class="category">👩‍⚕️ Стоматолог</div>

    <button class="question" onclick="showAnswer('Зачем ходить к стоматологу, если ничего не болит?')">
      👩‍⚕️ Зачем идти к стоматологу, если ничего не болит?
    </button>

    <button class="question" onclick="showAnswer('Как часто посещать стоматолога?')">
      📅 Как часто посещать стоматолога?
    </button>

    <button class="question" onclick="showAnswer('Что происходит на профилактическом осмотре?')">
      🔎 Что происходит на профилактическом осмотре?
    </button>

    <button class="question" onclick="showAnswer('Почему нельзя терпеть зубную боль?')">
      ⚠️ Почему нельзя долго терпеть зубную боль?
    </button>


    <div class="category">✨ Дополнительные вопросы</div>

    <button class="question" onclick="showAnswer('Почему появляется неприятный запах изо рта?')">
      😮 Почему появляется неприятный запах изо рта?
    </button>

    <button class="question" onclick="showAnswer('Почему кровоточат дёсны?')">
      🩸 Почему кровоточат дёсны?
    </button>

    <button class="question" onclick="showAnswer('Что такое зубной налёт?')">
      🦠 Что такое зубной налёт?
    </button>

    <button class="question" onclick="showAnswer('Что такое зубной камень?')">
      🪨 Что такое зубной камень?
    </button>

    <button class="question" onclick="showAnswer('Можно ли отбелить зубы дома?')">
      ✨ Можно ли отбелить зубы дома?
    </button>

  </div>


  <div class="answer-box" id="answerBox">

    <div class="answer-title" id="answerTitle"></div>

    <div id="answerText"></div>

  </div>


  <div class="small">
    Dental Guide — образовательный проект о здоровье полости рта.
    <br><br>
    Информация предназначена для общего образования
    и не заменяет консультацию стоматолога.
  </div>

</div>


<script>

const answers = {

"Как правильно чистить зубы?": `
Чистить зубы нужно мягко, без сильного давления. Расположи щётку примерно под углом 45° к линии дёсен и небольшими движениями очищай внешние, внутренние и жевательные поверхности зубов.

Важно проходить по всем участкам, а не чистить только те зубы, которые находятся спереди. Особое внимание стоит уделять линии дёсен и самым дальним зубам.

После чистки можно аккуратно очистить язык. Межзубные промежутки дополнительно очищают зубной нитью или другими подходящими средствами.
`,

"Как долго нужно чистить зубы?": `
Обычно рекомендуется уделять чистке зубов около двух минут. За это время можно последовательно очистить все поверхности зубов.

Удобно мысленно разделить рот на четыре участка и уделить каждому примерно одинаковое количество времени. Главное не скорость, а тщательность и регулярность.
`,

"Сколько раз в день чистить зубы?": `
Для большинства людей оптимальная базовая рекомендация — чистить зубы два раза в день: утром и вечером.

Вечерняя чистка особенно важна, потому что во время сна уменьшается количество слюны и естественное очищение полости рта становится слабее.

Кроме чистки щёткой, важно регулярно очищать промежутки между зубами.
`,

"Как выбрать зубную щётку?": `
Для ежедневного ухода большинству людей подходит щётка с мягкой или средней мягкостью щетины. Слишком сильное давление и жёсткая щетина могут травмировать дёсны и способствовать повреждению поверхности зубов.

Размер головки должен позволять удобно очищать даже дальние участки.

Электрическая и обычная щётка могут использоваться эффективно, если техника чистки правильная и человек регулярно ухаживает за зубами.
`,

"Как выбрать зубную пасту?": `
При выборе зубной пасты важно учитывать возраст и индивидуальные потребности человека.

Для профилактики кариеса часто используют пасты с фторидами в подходящей концентрации. Фтор помогает укреплять эмаль и повышать её устойчивость к воздействию кислот.

Если есть повышенная чувствительность, воспаление дёсен или другие проблемы, пасту лучше подбирать с учётом рекомендации стоматолога.
`,

"Нужно ли чистить язык?": `
Да. На поверхности языка могут задерживаться бактерии и остатки пищи. Это может способствовать появлению неприятного запаха.

Язык можно мягко очищать зубной щёткой или специальным очистителем. Не нужно сильно давить или пытаться очищать его до раздражения.

Очистка языка является дополнительной частью гигиены, но не заменяет чистку зубов и очищение между ними.
`,

"Зачем нужна зубная нить?": `
Зубная щётка хорошо очищает доступные поверхности, но ей трудно полностью попасть в узкие промежутки между зубами.

Зубная нить помогает удалить налёт и остатки пищи из этих участков. Использовать её нужно аккуратно, не травмируя дёсны.

Если человеку неудобно пользоваться нитью, стоматолог или гигиенист может подобрать другое средство для очищения межзубных промежутков.
`,

"Что такое кариес?": `
Кариес — это заболевание твёрдых тканей зуба, при котором постепенно разрушаются эмаль и расположенные глубже ткани.

В зубном налёте находятся бактерии. Когда человек часто употребляет содержащие сахара продукты и напитки, бактерии используют эти сахара и образуют кислоты. Кислоты могут снижать минеральную плотность эмали.

Если процесс продолжается, сначала появляются изменения эмали, затем повреждение становится глубже и может достигнуть дентина и пульпы.

Поэтому профилактика важна ещё до появления боли.
`,

"Почему появляется кариес?": `
Кариес возникает не из-за одной причины. На его развитие влияют зубной налёт, частое употребление сахаров, особенности слюны, состояние эмали, гигиена и другие факторы.

Особенно важно не только количество сладкого, но и частота его употребления. Если зубы много раз в течение дня подвергаются воздействию сахаров и кислот, у эмали остаётся меньше времени на восстановление.

Регулярная гигиена, фториды, разумное питание и профилактические осмотры помогают снизить риск кариеса.
`,

"Можно ли остановить кариес?": `
На самых ранних стадиях некоторые изменения эмали могут быть остановлены или частично восстановлены благодаря процессам реминерализации.

Но если в зубе уже сформировалась полноценная полость, самостоятельно восстановить потерянные ткани невозможно. В таком случае требуется лечение у стоматолога.

Поэтому раннее обнаружение проблемы позволяет сохранить больше собственных тканей зуба.
`,

"Почему болит зуб?": `
Зубная боль может возникать по разным причинам: при кариесе, воспалении пульпы, проблемах с тканями вокруг корня, травме, повышенной чувствительности и других состояниях.

По характеру боли не всегда можно точно определить причину самостоятельно. Например, кратковременная реакция на холодное и длительная самопроизвольная боль могут иметь разные причины.

Если боль повторяется, усиливается или появляется сама по себе, важно обратиться к стоматологу для осмотра.
`,

"Почему зуб реагирует на холодное?": `
Чувствительность к холодному может возникать, когда дентин становится более доступным для внешних раздражителей. Это бывает, например, при оголении корня или истончении защитных тканей.

Кратковременная чувствительность иногда связана с обычной гиперчувствительностью, но причиной также могут быть кариес, трещина или другие стоматологические проблемы.

Если чувствительность сильная, появилась недавно или не проходит, причину должен определить стоматолог.
`,

"Что такое пульпа?": `
Пульпа — это мягкая ткань, расположенная внутри зуба. В ней находятся кровеносные сосуды, соединительная ткань и нервные волокна.

Она участвует в питании и жизнедеятельности зуба, особенно во время его формирования.

Если инфекция из глубокого кариозного поражения достигает пульпы, может возникнуть воспаление, которое часто сопровождается выраженной болью и требует стоматологического лечения.
`,

"Что такое зубная эмаль?": `
Эмаль — самая наружная и очень твёрдая ткань зуба. Она защищает внутренние структуры от механического воздействия, температурных раздражителей и кислот.

Несмотря на высокую прочность, эмаль не является неразрушимой. Кислоты, образующиеся в результате деятельности бактерий, могут постепенно растворять её минералы.

Хорошая гигиена, фториды и рациональное питание помогают сохранить эмаль.
`,

"Что такое дентин?": `
Дентин находится под эмалью и составляет значительную часть зуба.

Он менее твёрдый, чем эмаль, и содержит микроскопические канальцы. Поэтому при оголении дентина зуб может становиться более чувствительным к холодному, горячему или сладкому.

Дентин окружает пульпу и защищает её от внешнего воздействия.
`,

"Из чего состоит зуб?": `
Зуб состоит из нескольких основных тканей.

Эмаль покрывает коронку и защищает зуб снаружи. Под ней находится дентин, который составляет основную массу зуба. В центре расположена пульпа с сосудами и нервными волокнами.

Корень находится внутри костной ткани челюсти и помогает удерживать зуб. Поверхность корня покрыта цементом.
`,

"Зачем зубу нужен корень?": `
Корень удерживает зуб в костной ткани челюсти и помогает передавать жевательную нагрузку.

Внутри корня проходят каналы, через которые проходят сосуды и нервы к пульпе.

Количество и форма корней отличаются у разных групп зубов, поэтому анатомия резца, клыка, премоляра и моляра может существенно различаться.
`,

"Что находится внутри зуба?": `
Внутри зуба расположена пульпарная камера, которая продолжается в корневые каналы.

В пульпе находятся сосуды, нервы и соединительная ткань. Именно поэтому воспаление этой области может вызывать сильную боль.

При глубоком поражении иногда требуется эндодонтическое лечение — очищение и пломбирование системы корневых каналов.
`,

"Зачем нужны брекеты?": `
Брекеты используются для ортодонтического перемещения зубов и коррекции положения зубных рядов.

С помощью системы брекетов и дуг создаются контролируемые силы, благодаря которым зубы постепенно перемещаются.

Лечение проводится под наблюдением ортодонта. Его длительность зависит от конкретной ситуации и индивидуального плана лечения.
`,

"Как чистить зубы с брекетами?": `
При брекетах гигиена становится особенно важной, потому что вокруг замочков и дуг легче задерживается налёт.

Нужно тщательно очищать поверхность зубов вокруг каждого элемента конструкции. Для этого могут использоваться ортодонтическая щётка, межзубные ёршики и другие средства, которые рекомендует ортодонт.

Если налёт остаётся надолго, повышается риск кариеса и воспаления дёсен.
`,

"Что нельзя есть с брекетами?": `
При ортодонтическом лечении важно избегать продуктов, которые могут повредить конструкцию: очень твёрдой пищи, которую приходится сильно откусывать, и липких продуктов.

Овощи и фрукты твёрдой консистенции при необходимости можно нарезать небольшими кусочками.

Конкретные ограничения лучше уточнить у своего ортодонта, потому что они зависят от конструкции.
`,

"Зачем нужен ретейнер?": `
После ортодонтического лечения зубы могут постепенно стремиться вернуться в прежнее положение.

Ретейнер помогает удерживать достигнутый результат. Он может быть съёмным или фиксированным.

Срок и режим его использования определяет ортодонт. Соблюдение рекомендаций важно для стабильности результата лечения.
`,

"Какие продукты полезны для зубов?": `
Для здоровья зубов важен не один конкретный продукт, а полноценный и разнообразный рацион.

Организму необходимы белки, витамины и минералы, участвующие в формировании и поддержании тканей. Источниками кальция, например, могут быть молочные продукты и другие продукты, содержащие этот минерал.

При этом стоит ограничивать частые сладкие перекусы и сладкие напитки, особенно между основными приёмами пищи.
`,

"Почему сладкое влияет на зубы?": `
Сахара сами по себе не «пробивают» зуб. Проблема заключается в том, что бактерии зубного налёта могут использовать их для образования кислот.

Эти кислоты воздействуют на минералы эмали. Если такие эпизоды происходят очень часто, риск кариеса повышается.

Поэтому важны не только количество сладкого, но и частота его употребления и последующая гигиена.
`,

"Вредны ли сладкие напитки?": `
Сладкие напитки могут повышать риск кариеса, потому что содержат свободные сахара. Кроме того, многие напитки являются кислыми и могут способствовать эрозивному повреждению эмали.

Особенно неблагоприятно постоянно пить сладкие напитки небольшими порциями в течение всего дня.

Для повседневного питья лучше выбирать воду, а сладкие напитки употреблять реже.
`,

"Почему важно пить воду?": `
Вода помогает поддерживать нормальное состояние полости рта и способствует естественному очищению.

Слюна является важной защитой зубов: она помогает нейтрализовать кислоты и участвует в восстановлении минералов эмали.

Обычная вода также не содержит сахара, поэтому для повседневного питья она является хорошим выбором.
`,

"Зачем идти к стоматологу, если ничего не болит?": `
Отсутствие боли не всегда означает отсутствие проблемы. Некоторые стоматологические заболевания на ранних стадиях могут практически не давать симптомов.

Во время профилактического осмотра стоматолог может обнаружить изменения раньше, чем они начнут беспокоить человека.

Раннее обнаружение часто позволяет провести менее сложное лечение и сохранить больше собственных тканей зуба.
`,

"Как часто посещать стоматолога?": `
Универсального интервала, одинакового для каждого человека, нет.

Частота профилактических посещений зависит от состояния зубов и дёсен, возраста, риска развития кариеса, наличия ортодонтического лечения и других факторов.

Поэтому оптимальный график лучше определить вместе со стоматологом.
`,

"Что происходит на профилактическом осмотре?": `
Стоматолог осматривает зубы, дёсны и другие ткани полости рта, оценивает состояние уже проведённого лечения и при необходимости рекомендует дополнительные исследования.

Врач также может объяснить, какие средства гигиены подходят именно этому человеку.

Профилактический визит — это не обязательно лечение. Его важная задача — вовремя заметить изменения и предупредить проблемы.
`,

"Почему нельзя терпеть зубную боль?": `
Зубная боль является сигналом, что в зубе или окружающих тканях происходит какой-то процесс.

Если откладывать обследование, причина может продолжать развиваться. Например, небольшое поражение может стать более глубоким.

Обезболивающее может временно уменьшить неприятные ощущения, но оно не устраняет причину. При сохраняющейся или сильной боли необходима консультация стоматолога.
`,

"Почему появляется неприятный запах изо рта?": `
Неприятный запах часто связан с бактериями и их продуктами в полости рта. Источником могут быть налёт на зубах и языке, воспаление дёсен, остатки пищи и некоторые стоматологические заболевания.

Важно регулярно чистить зубы, очищать язык и межзубные промежутки.

Если запах сохраняется несмотря на хорошую гигиену, стоит обратиться к стоматологу, чтобы определить причину.
`,

"Почему кровоточат дёсны?": `
Кровоточивость дёсен часто связана с воспалением, которое развивается из-за скопления зубного налёта.

Если резко прекратить очищать такие участки из-за кровоточивости, налёт может накапливаться ещё больше.

Правильная гигиена и профессиональная оценка состояния дёсен помогают определить причину. Если кровоточивость регулярная или выраженная, лучше обратиться к стоматологу.
`,

"Что такое зубной налёт?": `
Зубной налёт — это мягкая биоплёнка, которая постоянно образуется на поверхности зубов.

В ней находятся бактерии, остатки компонентов слюны и другие вещества. Если налёт регулярно не удалять, он может способствовать развитию кариеса и воспалению дёсен.

Поэтому ежедневная чистка зубов и очищение между ними являются основой профилактики.
`,

"Что такое зубной камень?": `
Зубной камень образуется, когда минералы слюны пропитывают и затвердевают в зубном налёте.

В отличие от мягкого налёта, обычной зубной щёткой полностью удалить твёрдые отложения невозможно.

Для их удаления используют профессиональную гигиену. Самостоятельно соскребать камень острыми предметами не следует — можно повредить ткани.
`,

"Можно ли отбелить зубы дома?": `
Оттенок зубов зависит от их естественного цвета, состояния эмали, дентина и наличия внешних окрашиваний.

Домашние средства для отбеливания отличаются по составу и эффективности. Некоторые агрессивные способы могут вызвать чувствительность или повредить ткани зуба.

Безопаснее сначала проконсультироваться со стоматологом и выяснить причину изменения цвета.
`

};


function showAnswer(question) {

  document.getElementById("questions").style.display = "none";

  document.getElementById("intro").style.display = "none";

  document.getElementById("backButton").style.display = "block";

  document.getElementById("answerBox").style.display = "block";

  document.getElementById("answerTitle").innerText = question;

  document.getElementById("answerText").innerHTML = answers[question];

  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });
}


function goBack() {

  document.getElementById("questions").style.display = "block";

  document.getElementById("intro").style.display = "block";

  document.getElementById("backButton").style.display = "none";

  document.getElementById("answerBox").style.display = "none";

  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });
}

</script>

</body>
</html>
